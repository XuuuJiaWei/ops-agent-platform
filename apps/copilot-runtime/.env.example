# Copilot runtime config. Copy to apps/copilot-runtime/.env for local overrides.
#
# The authoritative source for the backend chat URL and assistant id is
# config/config.yaml (server section). During `pnpm dev` the dev script derives
# AGUI_AGENT_URL and ASSISTANT_ID from it and injects them. The values below are
# only the fallback when the runtime is started on its own.

ASSISTANT_ID=agent
AGUI_AGENT_URL=http://127.0.0.1:8123/chat
COPILOT_RUNTIME_PORT=4001
COPILOT_RUNTIME_HOST=127.0.0.1

# When started through `pnpm dev`, both values are derived from config/config.yaml.
# The Postgres mode reads DATABASE_URL from the repository-root .env and stores
# CopilotKit's UI event log separately from LangGraph checkpoints.
OPS_PILOT_PERSISTENCE_BACKEND=memory
OPS_PILOT_PERSISTENCE_SETUP_ON_START=true
