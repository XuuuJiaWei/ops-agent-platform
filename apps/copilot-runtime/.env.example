# Local development reads these values from config/runtime.yaml through
# scripts/dev.mjs. This file is for a separately deployed bridge only; it has
# no business/runtime configuration and must not contain model or MCP secrets.

COPILOTKIT_AGENT_ID=agent
COPILOTKIT_AGUI_AGENT_URL=http://127.0.0.1:8123/chat
COPILOT_RUNTIME_PORT=4001
COPILOT_RUNTIME_HOST=127.0.0.1

# The Postgres mode reads DATABASE_URL from the repository-root .env and stores
# CopilotKit's UI event log separately from LangGraph checkpoints.
COPILOTKIT_EVENT_STORE_BACKEND=memory
COPILOTKIT_EVENT_STORE_SETUP_ON_START=true
