# Vite frontend config. Copy to apps/web/.env for local overrides.
#
# This entrypoint owns its browser/runtime declaration. During `pnpm dev`, the
# dev script reads OPS_PILOT_WEB_* values and injects matching public defaults.

# Browser-visible (only VITE_-prefixed vars are exposed to frontend code).
VITE_BACKEND_URL=http://127.0.0.1:8123
VITE_ASSISTANT_ID=agent
VITE_COPILOT_RUNTIME_URL=/api/copilotkit

# Vite dev server / proxy targets (not exposed to the browser; optional).
# BACKEND_URL=
# A2A_API_URL=
# COPILOT_RUNTIME_URL=http://127.0.0.1:4001
# WEB_PORT=3000
