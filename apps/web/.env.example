# Vite frontend config. Copy to apps/web/.env for local overrides.
#
# The authoritative source for backend host/port and assistant id is
# config/config.yaml (server section). During `pnpm dev` the dev scripts derive
# those values and inject them via process.env, which Vite prefers over these
# file values. The values below are only the fallback when apps/web is started
# on its own (`pnpm --filter ./apps/web dev:vite`).

# Browser-visible (only VITE_-prefixed vars are exposed to frontend code).
VITE_BACKEND_URL=http://127.0.0.1:8123
VITE_ASSISTANT_ID=agent
VITE_COPILOT_RUNTIME_URL=/api/copilotkit
VITE_PILOT_BRIDGE_INSTALL_URL=

# Vite dev server / proxy targets (not exposed to the browser; optional).
# BACKEND_URL=
# A2A_API_URL=
# COPILOT_RUNTIME_URL=http://127.0.0.1:4001
# WEB_PORT=3000
