# Copy this file to .env for local self-hosted Langfuse.
# Generate secrets with:
#   openssl rand -hex 32
#   openssl rand -base64 32

NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=CHANGEME
LANGFUSE_SALT=CHANGEME
LANGFUSE_ENCRYPTION_KEY=CHANGEME

POSTGRES_USER=langfuse
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=langfuse

CLICKHOUSE_DB=langfuse
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=CHANGEME

REDIS_AUTH=CHANGEME

MINIO_ROOT_USER=langfuse
MINIO_ROOT_PASSWORD=CHANGEME
MINIO_BUCKET=langfuse

LANGFUSE_HOST_PORT=3001
POSTGRES_HOST_PORT=15432
CLICKHOUSE_HTTP_HOST_PORT=18123
CLICKHOUSE_NATIVE_HOST_PORT=19000
REDIS_HOST_PORT=16379
MINIO_API_HOST_PORT=19090
MINIO_CONSOLE_HOST_PORT=19091

TELEMETRY_ENABLED=false
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=true
