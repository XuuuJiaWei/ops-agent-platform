# Copy this file to .env for the local ops_pilot Postgres.
# These values must match DATABASE_URL in the repository root .env:
#   DATABASE_URL=postgresql://ops_pilot:ops_pilot@127.0.0.1:5433/ops_pilot

POSTGRES_USER=ops_pilot
POSTGRES_PASSWORD=ops_pilot
POSTGRES_DB=ops_pilot
POSTGRES_HOST_PORT=5433
