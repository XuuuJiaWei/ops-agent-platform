# SAP AI Core / Generative AI Hub
# The SAP SDK can read authentication from local SDK config, environment variables,
# or VCAP_SERVICES. Leave AICORE_* empty if local SDK auth is already configured.
AICORE_CLIENT_ID=
AICORE_CLIENT_SECRET=
AICORE_AUTH_URL=
AICORE_BASE_URL=
AICORE_RESOURCE_GROUP=
SAP_AI_CORE_MODEL_NAME=anthropic--claude-4.6-sonnet
SAP_AI_CORE_MAX_TOKENS=8192

# Langfuse
# Leave these empty for local startup with tracing disabled.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Agent
APP_ENV=local
ASSISTANT_ID=agent
SYSTEM_PROMPT=
SKILLS_PATHS=./skills/examples/
# Leave empty until Dynatrace tokens are configured locally.
# Set to ./config/mcp.example.json to enable the Dynatrace Managed MCP server.
MCP_CONFIG_PATH=

# Dynatrace Managed MCP
DT_CONFIG_FILE=./dt-config.yaml
# Agent-native Dynatrace dashboard tool (render_dynatrace_dashboard). Set to
# false to remove it from the agent's toolset.
ENABLE_DYNATRACE_DASHBOARD=true
DT_PROD_TOKEN=
DT_STAGING_TOKEN=

# Local protocol surfaces
CHAT_BASE_PATH=/chat
A2A_BASE_PATH=/a2a
A2A_TASK_STORE=memory

# Frontend
VITE_BACKEND_URL=http://127.0.0.1:8123
VITE_CHAT_API_URL=/chat
VITE_A2A_API_URL=/a2a
VITE_ASSISTANT_ID=agent
VITE_COPILOT_RUNTIME_URL=/api/copilotkit
AGUI_AGENT_URL=http://127.0.0.1:8123/chat
VITE_COPILOT_SHOW_DEV_CONSOLE=false
# Conversation history metadata. Use local for self-contained development;
# switch to company with VITE_CONVERSATION_STORE_API_URL when an internal store is available.
VITE_CONVERSATION_STORE=local
VITE_CONVERSATION_STORE_API_URL=
VITE_PILOT_BRIDGE_INSTALL_URL=
