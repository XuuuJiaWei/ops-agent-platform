# Secrets only. Every non-sensitive runtime choice belongs in one of:
#   config/entries/web.yaml
#   config/entries/eval.yaml
#   config/entries/benchmark.yaml
#   config/entries/langgraph.yaml

# SAP AI Core / Generative AI Hub.
# Leave empty if the SAP SDK is already configured through local SDK config or VCAP_SERVICES.
AICORE_CLIENT_ID=
AICORE_CLIENT_SECRET=
AICORE_AUTH_URL=
AICORE_BASE_URL=
AICORE_RESOURCE_GROUP=

# OpenRouter (used by the default model configurations).
OPENROUTER_API_KEY=

# Generic fallback for non-SAP model providers.
MODEL_API_KEY=

# Optional Langfuse tracing. Also set `observability.enabled: true` in the entrypoint YAML.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Optional DeepAgents/OpenSandbox backend (the endpoint and enablement are in YAML).
OPEN_SANDBOX_API_KEY=

# Durable persistence, only when the selected entry enables postgres.
# DATABASE_URL=postgresql://ops_pilot:ops_pilot@127.0.0.1:5433/ops_pilot
DATABASE_URL=

# Optional authorization for Jaeger/Prometheus MCP endpoints declared in YAML.
MCP_BASIC_AUTH_HEADER=

# The Vite .env file is only for static browser build/deployment overrides.
# `pnpm dev` reads config/entries/web.yaml and passes its values to all local
# web-stack processes automatically.
