# ops_pilot secrets only. Regular config lives in config/config.yaml
# (copy from config/config.example.yaml). This file holds credentials and tokens.

# Points the backend at your local regular-config file.
OPS_PILOT_CONFIG=./config/config.yaml

# SAP AI Core / Generative AI Hub
# The SAP SDK reads these directly (or from local SDK config / VCAP_SERVICES).
# Leave empty if local SDK auth is already configured.
AICORE_CLIENT_ID=
AICORE_CLIENT_SECRET=
AICORE_AUTH_URL=
AICORE_BASE_URL=
AICORE_RESOURCE_GROUP=

# Non-SAP model providers (model.provider = deepseek/openai/anthropic/...).
# API key for the provider selected in config.yaml; base_url lives in config.yaml.
# DeepSeek: create a key at https://platform.deepseek.com/api_keys
MODEL_API_KEY=

# Langfuse (base URL is in config.yaml; keys are secret)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# DeepAgents sandbox backend (domain is in config.yaml; only the key is secret)
OPEN_SANDBOX_API_KEY=

# OTel demo public ops ingress basic auth (referenced by config.yaml MCP servers)
OTEL_BASIC_AUTH_USER=
OTEL_BASIC_AUTH_PASSWORD=
# Complete HTTP Authorization value for remote MCP endpoints, e.g. "Basic <base64>".
MCP_BASIC_AUTH_HEADER=

# Dynatrace Managed MCP tokens (referenced via ${VAR} in config.yaml mcpServers)
DT_PROD_TOKEN=
DT_STAGING_TOKEN=

# Frontend (consumed by apps/web and the copilot runtime, not the Python backend)
VITE_BACKEND_URL=http://127.0.0.1:8123
VITE_ASSISTANT_ID=agent
VITE_COPILOT_RUNTIME_URL=/api/copilotkit
VITE_PILOT_BRIDGE_INSTALL_URL=
AGUI_AGENT_URL=http://127.0.0.1:8123/chat
