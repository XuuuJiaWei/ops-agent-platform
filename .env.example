# ops_pilot secrets only. Regular config lives in config/config.yaml
# (copy from config/config.example.yaml). This file holds credentials and tokens.

# Points the backend at your local regular-config file.
OPS_PILOT_CONFIG=./config/config.yaml

# SAP AI Core / Generative AI Hub.
# Leave empty if the SAP SDK is already configured through local SDK config or VCAP_SERVICES.
AICORE_CLIENT_ID=
AICORE_CLIENT_SECRET=
AICORE_AUTH_URL=
AICORE_BASE_URL=
AICORE_RESOURCE_GROUP=

# Non-SAP model providers (model.provider = deepseek/openai/anthropic/...).
MODEL_API_KEY=

# Optional Langfuse tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Optional DeepAgents/OpenSandbox backend.
OPEN_SANDBOX_API_KEY=

# Durable persistence, only when config.yaml persistence.backend = postgres.
# DATABASE_URL=postgresql://ops_pilot:ops_pilot@127.0.0.1:5433/ops_pilot
DATABASE_URL=

# MCP/tool credentials are environment-specific. Reference any required variables
# from your local config.yaml instead of committing benchmark-cluster endpoints here.

# Frontend/runtime config lives next to each process:
#   apps/web/.env.example
#   apps/copilot-runtime/.env.example
