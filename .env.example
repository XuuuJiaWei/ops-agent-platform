# SAP AI Core / Generative AI Hub
# The SAP SDK can read authentication from local SDK config, environment variables,
# or VCAP_SERVICES. Leave AICORE_* empty if local SDK auth is already configured.
AICORE_CLIENT_ID=
AICORE_CLIENT_SECRET=
AICORE_AUTH_URL=
AICORE_BASE_URL=
AICORE_RESOURCE_GROUP=
SAP_AI_CORE_MODEL_NAME=anthropic--claude-4.6-sonnet
SAP_AI_CORE_MAX_TOKENS=8192

# Langfuse
# Leave these empty for local startup with tracing disabled.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Agent
APP_ENV=local
ASSISTANT_ID=agent
SYSTEM_PROMPT=
SKILLS_PATHS=./skills
# Leave empty until Dynatrace tokens are configured locally.
# Set to ./config/mcp.example.json to enable the Dynatrace Managed MCP server.
MCP_CONFIG_PATH=

# DeepAgents sandbox backend (OpenSandbox on Gardener)
# Leave OPEN_SANDBOX_ENABLED empty to auto-enable only when both domain and API key are set.
OPEN_SANDBOX_ENABLED=
OPEN_SANDBOX_DOMAIN=opensandbox.example.com
OPEN_SANDBOX_API_KEY=
OPEN_SANDBOX_PROTOCOL=https
OPEN_SANDBOX_USE_SERVER_PROXY=true
OPEN_SANDBOX_DISABLE_METRICS=true
OPEN_SANDBOX_IMAGE=python:3.11
OPEN_SANDBOX_TIMEOUT_SECONDS=600
OPEN_SANDBOX_READY_TIMEOUT_SECONDS=240
OPEN_SANDBOX_CPU_LIMIT=250m
OPEN_SANDBOX_MEMORY_LIMIT=256Mi
OPEN_SANDBOX_CPU_REQUEST=100m
OPEN_SANDBOX_MEMORY_REQUEST=128Mi

# Dynatrace Managed MCP (consumed by ./config/mcp.example.json + dt-config.yaml)
DT_CONFIG_FILE=./dt-config.yaml
DT_PROD_TOKEN=
DT_STAGING_TOKEN=

# Backend bind address (used by scripts/dev-backend.sh and the CLI)
CHAT_HOST=127.0.0.1
CHAT_PORT=8123

# Frontend
VITE_BACKEND_URL=http://127.0.0.1:8123
VITE_ASSISTANT_ID=agent
VITE_COPILOT_RUNTIME_URL=/api/copilotkit
VITE_PILOT_BRIDGE_INSTALL_URL=

# Copilot runtime (bridge between browser and AG-UI backend)
AGUI_AGENT_URL=http://127.0.0.1:8123/chat
