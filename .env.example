# Secrets and deployment values only. Runtime choices are declared in each
# entrypoint (`web`, `eval`, `benchmark`, or `langgraph`) via OPS_PILOT_<ENTRY>_*.

# SAP AI Core / Generative AI Hub.
# Leave empty if the SAP SDK is already configured through local SDK config or VCAP_SERVICES.
AICORE_CLIENT_ID=
AICORE_CLIENT_SECRET=
AICORE_AUTH_URL=
AICORE_BASE_URL=
AICORE_RESOURCE_GROUP=

# Non-SAP model providers.
MODEL_API_KEY=

# Optional Langfuse tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Optional DeepAgents/OpenSandbox backend.
OPEN_SANDBOX_API_KEY=

# Durable persistence, only when the selected entry enables postgres.
# DATABASE_URL=postgresql://ops_pilot:ops_pilot@127.0.0.1:5433/ops_pilot
DATABASE_URL=

# Example web-entry declaration inputs (each other entry uses its own prefix):
# OPS_PILOT_WEB_MODEL_PROVIDER=sap
# OPS_PILOT_WEB_MODEL_NAME=anthropic--claude-4.6-sonnet
# OPS_PILOT_WEB_KUBECONFIG=C:/Users/you/.kube/config
# OPS_PILOT_WEB_JAEGER_MCP_URL=https://jaeger.example/mcp
# OPS_PILOT_WEB_PROMETHEUS_MCP_URL=https://prometheus.example/mcp
# OPS_PILOT_WEB_MCP_BASIC_AUTH_HEADER=

# AIOpsLab benchmark launcher and its isolated runtime declaration.
# `pnpm benchmark` layers this editable checkout over the agent project only
# for that command; it never modifies services/agent/.venv.
# OPS_PILOT_AIOPSLAB_DIR=D:/dev/projects/AIOpsLab
# OPS_PILOT_BENCHMARK_MODEL_PROVIDER=openai
# OPS_PILOT_BENCHMARK_MODEL_NAME=gpt-4.1
# OPS_PILOT_BENCHMARK_KUBECONFIG=C:/Users/you/.kube/config
# OPS_PILOT_BENCHMARK_PROMETHEUS_MCP_URL=https://prometheus.example/mcp

# Frontend/runtime config lives next to each process:
#   apps/web/.env.example
#   apps/copilot-runtime/.env.example
